# Copy to frontend/.env.local. Nothing here is secret.

# Where the Spring Boot API runs (server-to-server; the browser never calls it directly).
BACKEND_URL=http://localhost:8080

# Set to true when the site is served over HTTPS (turns on HSTS and upgrade-insecure-requests).
HTTPS=false

# Map tiles (any XYZ raster provider). Defaults: OpenStreetMap France HOT (DECISIONS D5).
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_SUBDOMAINS=abc
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors, HOT
NEXT_PUBLIC_MAP_MAX_ZOOM=19
